# Copie para .env e troque os valores (ou rode ./scripts/iniciar.sh, que gera tudo).
# Nunca versione o .env.

# Segredos (obrigatórios) — use valores longos e aleatórios
POSTGRES_PASSWORD=troque-por-um-segredo-longo
CLICKHOUSE_PASSWORD=troque-por-outro-segredo-longo
REVOADA_JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres

# Endereços pelos quais pessoas e agentes chegam até aqui
REVOADA_PUBLIC_URL=http://localhost:8080
REVOADA_GATEWAY_PUBLIC_URL=http://localhost:8090
REVOADA_CANAL_HOSTS=localhost,127.0.0.1
REVOADA_CANAL_PUBLICO=localhost:7443

# Portas no host
REVOADA_PORTA=8080
REVOADA_PORTA_GATEWAY=8090
REVOADA_PORTA_OTLP_GRPC=4317
REVOADA_PORTA_CANAL=7443

# Com HTTPS na frente do painel, ligue os cookies seguros
REVOADA_SECURE_COOKIES=0

# Dias de retenção das séries
REVOADA_RETENTION_DAYS=120
