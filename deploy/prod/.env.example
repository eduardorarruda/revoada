# Segredos do Revoada (produção). Copie para /opt/revoada/.env e preencha.
# O bootstrap.sh gera valores aleatórios fortes automaticamente. NUNCA comitar o .env real.

# Postgres (config: usuários, dashboards, alertas, TVs)
POSTGRES_PASSWORD=troque-me

# ClickHouse (séries: métricas, logs, traces)
CLICKHOUSE_PASSWORD=troque-me

# JWT do server. Em produção o boot ABORTA se vazio/fraco. Gere: openssl rand -base64 48
REVOADA_JWT_SECRET=troque-me

# Tunables opcionais (têm default no código):
# REVOADA_RETENTION_DAYS=120
# REVOADA_RATE_LIMIT_RPS=500
# REVOADA_TRACE_SAMPLE=0.2
# REVOADA_TRACE_SAMPLE_SLOW_MS=1000

# Vigia do WhatsApp — quem é avisado se o wuzapi cair ou parar de entregar.
# WhatsApp: número (com DDD) e, de preferência, o LID dele (sem LID o WhatsApp pode
# aceitar e descartar o aviso em silêncio). E-mail: exige um servidor SMTP.
# REVOADA_VIGIA_WHATSAPP=55DDDNUMERO
# REVOADA_VIGIA_WHATSAPP_LID=
# REVOADA_VIGIA_EMAIL=voce@exemplo.com
# REVOADA_SMTP_HOST=smtp.gmail.com
# REVOADA_SMTP_PORT=465
# REVOADA_SMTP_USER=conta-que-envia@exemplo.com
# REVOADA_SMTP_PASSWORD=senha-de-app-do-gmail
# REVOADA_SMTP_FROM=
